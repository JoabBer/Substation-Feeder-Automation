          <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
            <InterfaceAsPlainText>
              <xhtml xmlns="http://www.w3.org/1999/xhtml">PROGRAM Heartbeat
VAR
    {attribute 'symbol' := 'read'}
    Counter : UDINT := 0;
    PulseTimer : TON;
    CommandTimer : TON;
END_VAR
</xhtml>
            </InterfaceAsPlainText>
          </data>
        </addData>
