      <pou name="Heartbeat" pouType="program">
        <interface>
          <localVars>
            <variable name="Counter">
              <type>
                <UDINT />
              </type>
              <initialValue>
                <simpleValue value="0" />
              </initialValue>
              <addData>
                <data name="http://www.3s-software.com/plcopenxml/attributes" handleUnknown="implementation">
                  <Attributes>
                    <Attribute Name="symbol" Value="read" />
                  </Attributes>
                </data>
              </addData>
            </variable>
            <variable name="PulseTimer">
              <type>
                <derived name="TON" />
              </type>
            </variable>
            <variable name="CommandTimer">
              <type>
                <derived name="TON" />
              </type>
            </variable>
            <addData>
              <data name="http://www.3s-software.com/plcopenxml/interfaceasplaintext" handleUnknown="implementation">
                <InterfaceAsPlainText>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">PROGRAM Heartbeat
VAR
    {attribute 'symbol' := 'read'}
    Counter : UDINT := 0;
    PulseTimer : TON;
    CommandTimer : TON;
END_VAR
</xhtml>
                </InterfaceAsPlainText>
              </data>
            </addData>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// Called after PLC_PRG in the same MainTask.
// Increment every ~500 ms. Explicit wrap avoids overflow exceptions.
PulseTimer(IN := NOT PulseTimer.Q, PT := T#500ms);
IF PulseTimer.Q THEN
    IF Counter &gt;= UDINT#4294967295 THEN
        Counter := 0;
    ELSE
        Counter := Counter + 1;
    END_IF;
END_IF;

// Lab HMI command duration guard. This POU runs after PLC_PRG.
// Independent of browser/Gateway cleanup; outputs recompute next 20 ms scan.
CommandTimer(IN := PLC_PRG.Cmd_CB_Open OR PLC_PRG.Cmd_CB_Close, PT := T#7s);
IF CommandTimer.Q THEN
    PLC_PRG.Cmd_CB_Open := FALSE;
    PLC_PRG.Cmd_CB_Close := FALSE;
END_IF;
</xhtml>
          </ST>
        </body>
